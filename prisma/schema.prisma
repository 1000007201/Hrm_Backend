generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String       @id
  name          String
  email         String
  emailVerified Boolean      @default(false)
  image         String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  sessions      Session[]
  accounts      Account[]
  members       Member[]
  invitations   Invitation[]
  employee      Employee?

  @@unique([email])
  @@map("user")
}

model Session {
  id                   String   @id
  expiresAt            DateTime
  token                String
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  ipAddress            String?
  userAgent            String?
  userId               String
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeOrganizationId String?

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Organization {
  id            String         @id
  name          String
  slug          String
  logo          String?
  createdAt     DateTime
  metadata      String?
  members       Member[]
  invitations   Invitation[]
  employees     Employee[]
  leaveTypes    LeaveType[]
  leaveBalances LeaveBalance[]

  @@unique([slug])
  @@map("organization")
}

model Member {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           String       @default("member")
  createdAt      DateTime

  @@index([organizationId])
  @@index([userId])
  @@map("member")
}

model Invitation {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  role           String?
  status         String       @default("pending")
  expiresAt      DateTime
  createdAt      DateTime     @default(now())
  inviterId      String
  user           User         @relation(fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([email])
  @@map("invitation")
}

enum EmployeeRole {
  ADMIN
  HR
  MANAGER
  EMPLOYEE
}

model Employee {
  id             String  @id @default(cuid())
  userId         String? @unique
  organizationId String

  fullName    String
  email       String
  designation String?
  role        EmployeeRole @default(EMPLOYEE)
  invitedAt   DateTime?
  // Used for leave-accrual eligibility: an employee doesn't accrue for months
  // before they joined. Nullable — null is treated as "always eligible" (e.g.
  // existing employees created before this field existed).
  joiningDate DateTime?

  managerId String?
  manager   Employee?  @relation("Reports", fields: [managerId], references: [id])
  reports   Employee[] @relation("Reports")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // SetNull (not Cascade): the Employee is an HR record independent of portal
  // login — deleting the linked User account should just revoke login, not
  // erase the HR artifact.
  user          User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  leaveBalances LeaveBalance[]

  @@unique([organizationId, email])
  @@index([organizationId])
  @@index([managerId])
}

// One row per (org, leave code) — e.g. CL/SL/EL. accrualPerMonth is credited
// to every eligible employee's balance each month, capped at annualCap for
// the year (see accrueForOrg in src/lib/leaveAccrual.ts).
model LeaveType {
  id              String  @id @default(cuid())
  organizationId  String
  name            String
  code            String
  accrualPerMonth Decimal @db.Decimal(5, 2)
  annualCap       Int
  isPaid          Boolean @default(true)
  allowHalfDay    Boolean @default(true)
  isActive        Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  balances     LeaveBalance[]

  @@unique([organizationId, code])
  @@index([organizationId])
}

// One row per (employee, leave type, year). Available balance is computed
// (accruedDays - usedDays), not stored. lastAccruedMonth records the last
// calendar month (1-12) accrueForOrg applied for this year, so re-running a
// month is a no-op and a missed month can be applied later.
model LeaveBalance {
  id               String  @id @default(cuid())
  organizationId   String
  employeeId       String
  leaveTypeId      String
  year             Int
  accruedDays      Decimal @default(0) @db.Decimal(6, 2)
  usedDays         Decimal @default(0) @db.Decimal(6, 2)
  lastAccruedMonth Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employee     Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType    LeaveType    @relation(fields: [leaveTypeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, leaveTypeId, year])
  @@index([organizationId])
}
