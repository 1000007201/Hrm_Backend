# Copy to .env and fill in real values.
NODE_ENV=development
PORT=4000

# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/hrm?schema=public"

# Better Auth
# Generate a strong secret, e.g.: openssl rand -base64 32
BETTER_AUTH_SECRET="replace-with-a-random-string-at-least-32-characters-long"
BETTER_AUTH_URL="http://localhost:4000"

# Origin of the frontend app allowed to call this API with credentials
FRONTEND_ORIGIN="http://localhost:3000"

# Resend (https://resend.com) — leave RESEND_API_KEY unset in dev to log
# emails to the console instead of sending them
RESEND_API_KEY=""
EMAIL_FROM="onboarding@resend.dev"

# Require a verified email before sign-in works. Off by default; flip on
# once the frontend has a verify-email page to send users to.
REQUIRE_EMAIL_VERIFICATION="false"

# Company registration gating (POST /api/register-company).
# While ENABLE_PUBLIC_SIGNUP is false, callers must send the value below as
# an X-Registration-Secret header. Generate with: openssl rand -base64 32
ENABLE_PUBLIC_SIGNUP="false"
REGISTRATION_SECRET="replace-with-a-random-string-at-least-16-characters-long"

# Shared secret gating POST /system/leave/accrual/run-all (sent as the
# X-Accrual-Secret header). Only the monthly cron should know this value.
# Generate with: openssl rand -base64 32
ACCRUAL_SECRET="replace-with-a-random-string-at-least-16-characters-long"

# Attendance: worked minutes below this on a day with attendance count as
# HALF_DAY rather than PRESENT. Default 240 (4h of an 8h day).
ATTENDANCE_HALF_DAY_THRESHOLD_MINUTES="240"
